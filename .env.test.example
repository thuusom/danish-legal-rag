# Test environment configuration — copy to .env.test (gitignored) on the test host.
# Required by docker-compose.test.yml and scripts/deploy-test.sh.

# Image tag to deploy. Required — usually a pre-release tag like 1.2.0-rc.1.
IMAGE_TAG=

# LLM provider for end-to-end tests. Use 'mock' for cheap deterministic runs;
# switch to 'anthropic' for full e2e against the real LLM.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Cache and Qdrant config (mirror prod defaults, container-internal).
RETSINFORMATION_API_URL=https://retsinformation-api.dk
LAW_CACHE_DIR=/cache/laws
QDRANT_HOST=qdrant-test
QDRANT_PORT=6333
