# ── Production image tag (docker-compose.prod.yml) ─────────────────────────
# Override the image version used by `make prod-up`. Defaults to the value
# in the VERSION file at repo root (currently 0.1.0).
# IMAGE_TAG=0.1.0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Embedding provider: 'sentence-transformers' (default, offline) or 'openai'
EMBEDDING_PROVIDER=sentence-transformers

# sentence-transformers model (supports Danish)
ST_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

# LLM provider: 'anthropic' (default), 'openai', 'ollama', or 'mock'
LLM_PROVIDER=anthropic

# Anthropic API key (required for LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Anthropic model
ANTHROPIC_MODEL=claude-opus-4-5

# OpenAI API key (required for LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI models
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Ollama (local LLM server) ──────────────────────────────────────────────
# Set LLM_PROVIDER=ollama to use a local Ollama instance instead of cloud APIs.
# Ollama exposes an OpenAI-compatible /v1 endpoint – no API key needed.
#
# To use your server:
#   LLM_PROVIDER=ollama
#   OLLAMA_BASE_URL=http://woodcock2.vpn:7869/v1
#   OLLAMA_MODEL=llama3.3:70b
#
# Recommended models for Danish legal text (pull first: ollama pull <model>):
#   llama3.3:70b   – Best quality, strong Danish + legal reasoning. ~40 GB RAM.
#   qwen2.5:32b    – Excellent multilingual, good structured output. ~20 GB RAM.
#   qwen2.5:14b    – Lighter Qwen2.5 variant. ~9 GB RAM.
#   mistral-nemo   – Fast, decent Danish, low memory footprint. ~8 GB RAM.
#   gemma3:27b     – Google model, good multilingual reasoning. ~17 GB RAM.
#
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3:70b

# ── Retrieval strategy ──────────────────────────────────────────────────────
# Controls how chunks are retrieved from Qdrant.
#   dense   – (default) Dense vector similarity only (cosine on sentence-transformers embeddings)
#   hybrid  – Dense + sparse BM25 vectors fused via Reciprocal Rank Fusion (RRF)
#
# IMPORTANT: Switching to 'hybrid' requires re-ingestion so that sparse vectors
# are stored alongside dense vectors. After changing this, run:
#   docker compose down -v && docker compose up --build
RETRIEVAL_STRATEGY=dense

# ── Answer style ────────────────────────────────────────────────────────────
# Path to the Markdown style guide injected into every LLM system prompt.
# Mounted as a Docker volume so edits take effect without rebuilding the image.
# Leave empty to use the file at /app/answer-style.md (default).
ANSWER_STYLE_FILE=

# ── Retsinformation.dk live fetch ──────────────────────────────────────────
# Set to 'true' to attempt fetching live law texts from retsinformation.dk
# Default is 'false' (uses local fallback files)
FETCH_LIVE=false

# ── Law cache ──────────────────────────────────────────────────────────────
# Path inside the container where law JSON cache is stored.
# Mount as a Docker named volume to persist across container restarts.
# Most users won't need to change this — docker-compose mounts the
# `law_cache` named volume here on the ingest service.
LAW_CACHE_DIR=/cache/laws
