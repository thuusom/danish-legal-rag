# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Embedding provider: 'sentence-transformers' (default, offline) or 'openai'
EMBEDDING_PROVIDER=sentence-transformers

# sentence-transformers model (supports Danish)
ST_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2

# LLM provider: 'anthropic' (default), 'openai', or 'mock'
LLM_PROVIDER=anthropic

# Anthropic API key (required for LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Anthropic model
ANTHROPIC_MODEL=claude-opus-4-5

# OpenAI API key (required for LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# OpenAI models
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to 'true' to attempt fetching live law texts from retsinformation.dk
# Default is 'false' (uses local fallback files)
FETCH_LIVE=false
